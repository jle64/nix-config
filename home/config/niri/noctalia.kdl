layout {

    focus-ring {
        active-color   "#e87b97"
        inactive-color "#291419"
        urgent-color   "#e87b97"
    }

    border {
        active-color   "#e87b97"
        inactive-color "#291419"
        urgent-color   "#e87b97"
    }


    tab-indicator {
        active-color   "#e87b97"
        inactive-color "#9a1638"
        urgent-color   "#e87b97"
    }

    insert-hint {
        color "#e87b9780"
    }
}

recent-windows {
    highlight {
        active-color "#e87b97"
        urgent-color "#e87b97"
    }
}
