layout {

    focus-ring {
        active-color   "#00647f"
        inactive-color "#f6fafd"
        urgent-color   "#ba1a1a"
    }

    border {
        active-color   "#00647f"
        inactive-color "#f6fafd"
        urgent-color   "#ba1a1a"
    }


    tab-indicator {
        active-color   "#00647f"
        inactive-color "#007fa0"
        urgent-color   "#ba1a1a"
    }

    insert-hint {
        color "#00647f80"
    }
}

recent-windows {
    highlight {
        active-color "#00647f"
        urgent-color "#ba1a1a"
    }
}
